datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  plan      PlanType     @default(PRO)
  maxUsers  Int          @default(10)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users   User[]
  clients Client[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TENANT_USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedClients Client[] @relation("AssignedClients")

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TENANT_USER
}

enum DoNotContactReason {
  PREJUIZO
  SOLICITACAO
  OUTRO
}

model Client {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUserId     String?
  assignedUser       User?               @relation("AssignedClients", fields: [assignedUserId], references: [id], onDelete: Restrict)
  name               String
  cpf                String
  phone              String?
  email              String?
  city               String?
  uf                 String?
  obs                String?             @db.Text
  doNotContact       Boolean             @default(false)
  doNotContactReason DoNotContactReason?
  lastContactDate    String?
  taskDate           String?
  taskTime           String?
  isArchived         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  history ClientHistory[]
  cases   InsuranceCase[]

  @@unique([tenantId, cpf])
  @@index([tenantId, isArchived])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, doNotContact])
  @@index([tenantId, taskDate])
  @@map("clients")
}

model ClientHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  time      String
  txt       String   @db.Text
  createdAt DateTime @default(now())

  @@map("client_histories")
}

enum CaseStatus {
  AGUARDANDO_CONTATO
  AGUARDANDO_RESPOSTA
  NAO_ACEITOU
  CONVERTIDO
  CANCELAMENTO
  PAGAMENTO
  FINALIZADO
  PERDIDO
}

enum ContractStatus {
  PENDENTE
  ENVIADO
  RECEBIDO
  CONFERIDO
}

enum DocumentType {
  APOLICE
  TERMO
  COMPROVANTE
  DOCUMENTO_CLIENTE
  OUTRO
}

model InsuranceCase {
  id       String @id @default(cuid())
  tenantId String
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  policyNumber   String?
  insurer        String?
  insuranceType  String?
  identifiedAt   String?
  policyStartAt  String?
  policyEndAt    String?
  quantity       Int         @default(1)
  insuranceValue Decimal?    @db.Decimal(12, 2)
  obs            String?     @db.Text
  status         CaseStatus  @default(AGUARDANDO_CONTATO)
  contractStatus ContractStatus @default(PENDENTE)

  cancellationRequestedAt String?
  cancellationConfirmedAt String?
  cancellationNotes       String? @db.Text

  expectedClientAmount Decimal? @db.Decimal(12, 2)
  receivedClientAmount Decimal? @db.Decimal(12, 2)
  clientReceivedAt     String?

  companyAmount     Decimal? @db.Decimal(12, 2)
  companyDueAt      String?
  companyPaidAmount Decimal? @db.Decimal(12, 2)
  companyPaidAt     String?

  myCommission Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents CaseDocument[]

  @@index([tenantId, status])
  @@index([clientId])
  @@map("insurance_cases")
}

model CaseDocument {
  id        String            @id @default(cuid())
  caseId    String
  case      InsuranceCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type      DocumentType      @default(OUTRO)
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime          @default(now())

  @@map("case_documents")
}
